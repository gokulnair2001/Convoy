{
  "name": "convoy-e2e",
  "version": "0.1.6",
  "description": "Semantic end-to-end agent testing for iOS, Android, and web.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "convoy": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "agent",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js && cp src/drivers/idb-bridge.py dist/drivers/idb-bridge.py",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "convoy": "tsx src/cli/index.ts"
  },
  "keywords": [
    "e2e",
    "testing",
    "ios",
    "android",
    "playwright",
    "jev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokulnair2001/Convoy.git"
  },
  "bugs": {
    "url": "https://github.com/gokulnair2001/Convoy/issues"
  },
  "homepage": "https://github.com/gokulnair2001/Convoy#readme",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1",
    "vitest": "^2.1.1",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
